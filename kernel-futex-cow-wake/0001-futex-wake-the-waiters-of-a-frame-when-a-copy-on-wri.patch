+/// Wake every context that is waiting on a futex inside `frame`, without consuming a value.
+///
+/// Futexes are keyed by physical address. When a page that is shared copy-on-write (after a
+/// fork) is written, the writer's mapping moves to a new frame, so a FUTEX_WAKE issued
+/// afterwards, translated through the new mapping, no longer finds the threads of the same
+/// process that went to sleep on the old frame: they sleep forever. Called by the page fault
+/// handler when it moves a page, this wakes them; FUTEX_WAIT is allowed to return spuriously,
+/// and the woken thread re-reads the futex word through the new mapping and, if need be, waits
+/// again under the new address.
+pub fn wake_frame(frame: Frame) {
+    let base = frame.base().data();
+    let end = base + PAGE_SIZE;
+
+    // Same lock-order bend as in `futex` below: called with the address space locked.
+    let mut token = unsafe { CleanLockToken::new() };
+    let mut futexes = FUTEXES.lock(token.token());
+    let (futexes_map, mut token) = futexes.token_split();
+    if futexes_map.is_empty() {
+        return;
+    }
+
+    let keys: Vec<PhysicalAddress> = futexes_map
+        .keys()
+        .copied()
+        .filter(|key| (base..end).contains(&key.data()))
+        .collect();
+    for key in keys {
+        if let Some(waiters) = futexes_map.remove(&key) {
+            for waiter in waiters {
+                if let Some(ctx) = waiter.context_lock.upgrade() {
+                    unblock_context(&ctx, &mut token.token().downgrade());
+                }
+            }
+        }
+    }
+}
