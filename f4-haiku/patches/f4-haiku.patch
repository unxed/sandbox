diff --git a/internal/terminal/pty_haiku.go b/internal/terminal/pty_haiku.go
new file mode 100644
index 0000000..e66be42
--- /dev/null
+++ b/internal/terminal/pty_haiku.go
@@ -0,0 +1,190 @@
+//go:build haiku
+
+package terminal
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"unsafe"
+
+	"github.com/unxed/vtui"
+	"golang.org/x/sys/unix"
+)
+
+// PTY handles pseudo-terminal allocation and process execution.
+type PTY struct {
+	Master    *os.File
+	Slave     *os.File
+	Cmd       *exec.Cmd
+	closed    bool
+	closeOnce sync.Once
+	shellPgrp int
+}
+
+// Haiku's own posix_openpt/grantpt/ptsname_r/unlockpt
+// (src/system/libroot/posix/stdlib/pty.cpp in github.com/haiku/haiku) are
+// thin wrappers around two custom ioctls from
+// headers/private/drivers/tty.h, both offsets from TCGETA (0x8000, see
+// headers/posix/termios.h):
+//
+//	B_IOCTL_GET_TTY_INDEX = TCGETA + 32 = 0x8020  (param: int32*)
+//	B_IOCTL_GRANT_TTY     = TCGETA + 33 = 0x8021  (no param)
+//
+// posix_openpt itself is just open("/dev/ptmx", flags), and unlockpt is a
+// no-op on Haiku — there's no TIOCSPTLCK-equivalent lock to release like
+// on Linux. The slave path is /dev/tt/<letter><hex-digit>: letter starts
+// at 'p' + index/16, second character is index%16 in hex. All of this is
+// reproduced directly from that source, not guessed — see
+// f4-haiku/README.md in the sandbox for the link and the rest of the
+// project's rationale. Not verified end-to-end on real Haiku hardware,
+// same caveat as everything else added for this port.
+const (
+	bIoctlGetTTYIndex = 0x8020
+	bIoctlGrantTTY    = 0x8021
+)
+
+func ptyIndexToSlaveName(index int32) string {
+	letter := byte('p' + index/16)
+	return fmt.Sprintf("/dev/tt/%c%x", letter, index%16)
+}
+
+func NewPTY() (*PTY, error) {
+	// See pty_linux.go for why O_CLOEXEC and non-blocking mode matter here
+	// (leaked ptys / unkillable readers otherwise) — same reasoning
+	// applies on Haiku.
+	masterFd, err := unix.Open("/dev/ptmx", unix.O_RDWR|unix.O_NOCTTY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.SetNonblock(masterFd, true); err != nil {
+		unix.Close(masterFd)
+		return nil, err
+	}
+
+	master := os.NewFile(uintptr(masterFd), "/dev/ptmx")
+
+	if _, _, e1 := syscall.Syscall(syscall.SYS_IOCTL, uintptr(masterFd), bIoctlGrantTTY, 0); e1 != 0 {
+		master.Close()
+		return nil, e1
+	}
+
+	var index int32
+	if _, _, e1 := syscall.Syscall(syscall.SYS_IOCTL, uintptr(masterFd), bIoctlGetTTYIndex, uintptr(unsafe.Pointer(&index))); e1 != 0 {
+		master.Close()
+		return nil, e1
+	}
+
+	slaveName := ptyIndexToSlaveName(index)
+	slaveFd, err := unix.Open(slaveName, unix.O_RDWR|unix.O_NOCTTY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		master.Close()
+		return nil, err
+	}
+
+	slave := os.NewFile(uintptr(slaveFd), slaveName)
+
+	p := &PTY{
+		Master: master,
+		Slave:  slave,
+	}
+	registerPTYOpened()
+	return p, nil
+}
+
+func (p *PTY) Write(b []byte) (int, error) {
+	return p.Master.Write(b)
+}
+
+func (p *PTY) Read(b []byte) (int, error) {
+	return p.Master.Read(b)
+}
+
+func (p *PTY) Close() error {
+	var err error
+	p.closeOnce.Do(func() {
+		vtui.DebugLog("PTY: Closing PTY and killing child process group")
+		if p.Cmd != nil && p.Cmd.Process != nil {
+			_ = syscall.Kill(-p.Cmd.Process.Pid, syscall.SIGKILL)
+			p.Cmd.Process.Kill()
+		}
+		if p.Master != nil {
+			err = p.Master.Close()
+		}
+		if p.Slave != nil {
+			p.Slave.Close()
+		}
+		p.closed = true
+		registerPTYClosed()
+	})
+	return err
+}
+
+func (p *PTY) Wait() error {
+	return p.Cmd.Wait()
+}
+
+func (p *PTY) Run(name string, args ...string) error {
+	p.Cmd = exec.Command(name, args...)
+	p.Cmd.Stdin = p.Slave
+	p.Cmd.Stdout = p.Slave
+	p.Cmd.Stderr = p.Slave
+	p.Cmd.Env = TerminalChildEnv()
+	p.Cmd.SysProcAttr = &syscall.SysProcAttr{
+		Setsid:  true,
+		Setctty: true,
+	}
+
+	p.SetSize(80, 24)
+
+	err := p.Cmd.Start()
+	if err == nil {
+		p.shellPgrp, _ = syscall.Getpgid(p.Cmd.Process.Pid)
+	}
+	return err
+}
+
+func (p *PTY) IsBusy() bool {
+	if p.Master == nil {
+		return false
+	}
+	var pgrp int32
+	_, _, err := syscall.Syscall(syscall.SYS_IOCTL, p.Master.Fd(), unix.TIOCGPGRP, uintptr(unsafe.Pointer(&pgrp)))
+	if err != 0 {
+		return false
+	}
+	return int(pgrp) != p.shellPgrp
+}
+
+func (p *PTY) SetSize(cols, rows int) {
+	p.SetSizePixels(cols, rows, 0, 0)
+}
+
+// SetSizePixels also reports the size of the window in pixels, which is how
+// a program in the terminal learns the shape of a character cell.
+func (p *PTY) SetSizePixels(cols, rows, xpixel, ypixel int) {
+	size := struct {
+		Row, Col, Xpixel, Ypixel uint16
+	}{
+		Row:    uint16(rows),
+		Col:    uint16(cols),
+		Xpixel: ptyPixels(xpixel),
+		Ypixel: ptyPixels(ypixel),
+	}
+	_, _, _ = syscall.Syscall(syscall.SYS_IOCTL, p.Master.Fd(), unix.TIOCSWINSZ, uintptr(unsafe.Pointer(&size)))
+}
+
+func GetSystemShell() string {
+	shell := os.Getenv("SHELL")
+	if shell == "" {
+		return "/bin/sh"
+	}
+	base := filepath.Base(shell)
+	if base == "fish" || base == "csh" || base == "tcsh" {
+		return "bash"
+	}
+	return shell
+}
