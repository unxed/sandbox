diff --git a/fs_chmod_haiku.go b/fs_chmod_haiku.go
new file mode 100644
index 0000000..fe299b4
--- /dev/null
+++ b/fs_chmod_haiku.go
@@ -0,0 +1,36 @@
+//go:build haiku
+// +build haiku
+
+package zip
+
+import (
+	"os"
+	"time"
+)
+
+// Haiku, like Linux, treats a symlink's own permission bits and timestamps
+// as meaningless, so this follows the same path fs_chmod_unix.go's linux
+// case takes: skip symlinks, and use the ordinary (link-following) os.Chmod
+// / os.Chtimes for everything else, instead of the dirfd-relative
+// unix.Fchmodat/unix.Lutimes — unavailable here since golang.org/x/sys/unix
+// has no Haiku port (see this project's f4-haiku sandbox patches).
+
+func lchmod(name string, mode os.FileMode) error {
+	if mode&os.ModeSymlink != 0 {
+		return nil
+	}
+	if err := os.Chmod(name, mode); err != nil {
+		return &os.PathError{Op: "lchmod", Path: name, Err: err}
+	}
+	return nil
+}
+
+func lchtimes(name string, mode os.FileMode, atime, mtime time.Time) error {
+	if mode&os.ModeSymlink != 0 {
+		return nil
+	}
+	if err := os.Chtimes(name, atime, mtime); err != nil {
+		return &os.PathError{Op: "lchtimes", Path: name, Err: err}
+	}
+	return nil
+}
diff --git a/fs_chmod_unix.go b/fs_chmod_unix.go
new file mode 100644
index 0000000..b9900df
--- /dev/null
+++ b/fs_chmod_unix.go
@@ -0,0 +1,41 @@
+//go:build !windows && !haiku
+// +build !windows,!haiku
+
+package zip
+
+import (
+	"os"
+	"runtime"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func lchmod(name string, mode os.FileMode) error {
+	var flags int
+	if runtime.GOOS == "linux" {
+		if mode&os.ModeSymlink != 0 {
+			return nil
+		}
+	} else {
+		flags = unix.AT_SYMLINK_NOFOLLOW
+	}
+
+	err := unix.Fchmodat(unix.AT_FDCWD, name, uint32(mode), flags)
+	if err != nil {
+		return &os.PathError{Op: "lchmod", Path: name, Err: err}
+	}
+	return nil
+}
+
+func lchtimes(name string, mode os.FileMode, atime, mtime time.Time) error {
+	at := unix.NsecToTimeval(atime.UnixNano())
+	mt := unix.NsecToTimeval(mtime.UnixNano())
+	tv := [2]unix.Timeval{at, mt}
+
+	err := unix.Lutimes(name, tv[:])
+	if err != nil {
+		return &os.PathError{Op: "lchtimes", Path: name, Err: err}
+	}
+	return nil
+}
