 func lchtimes(name string, mode os.FileMode, atime, mtime time.Time) error {
+	// Same rationale as lchmod above: no unix.Lutimes/NsecToTimeval/Timeval
+	// on Haiku (via the current minimal x/sys/unix shim), and symlink
+	// timestamps are as meaningless there as symlink permissions, so skip
+	// symlinks and use the ordinary (link-following) os.Chtimes for real
+	// files.
+	if runtime.GOOS == "haiku" {
+		if mode&os.ModeSymlink != 0 {
+			return nil
+		}
+		if err := os.Chtimes(name, atime, mtime); err != nil {
+			return &os.PathError{Op: "lchtimes", Path: name, Err: err}
+		}
+		return nil
+	}
+
 	at := unix.NsecToTimeval(atime.UnixNano())
 	mt := unix.NsecToTimeval(mtime.UnixNano())
 	tv := [2]unix.Timeval{at, mt}
