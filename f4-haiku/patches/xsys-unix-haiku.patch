diff --git a/unix/haiku_amd64.go b/unix/haiku_amd64.go
new file mode 100644
index 0000000..be4391d
--- /dev/null
+++ b/unix/haiku_amd64.go
@@ -0,0 +1,361 @@
+// Minimal Haiku (haiku/amd64) support for golang.org/x/sys/unix.
+//
+// Upstream x/sys/unix has no Haiku port — Haiku isn't an upstream Go GOOS
+// at all (golang/go#56224 was closed "not planned"); the real Go-for-Haiku
+// toolchain lives in github.com/korli/go. This file provides only the
+// symbols actually referenced by github.com/unxed/f4's current dependency
+// graph on a GOOS=haiku build, not a full x/sys/unix port.
+//
+// - PollFd's layout and the POLL* bits are the same on every real POSIX
+//   poll(2) (Linux, the BSDs, ...); Haiku is no different here.
+// - Poll and Mprotect go through raw numbered syscalls (SYS_POLL,
+//   SYS_SET_MEMORY_PROTECTION) via the stdlib syscall package, which
+//   github.com/korli/go's Haiku port already implements natively
+//   (src/syscall/{zsysnum,zerrors}_haiku_amd64.go) — no dynamic libroot.so
+//   call needed for either.
+// - Mmap/Munmap/SetsockoptInt delegate straight to the stdlib syscall
+//   package, which already wraps Haiku's libroot.so/libnetwork.so calls
+//   for these (mmap, munmap, setsockopt all go through dynamic linking on
+//   Haiku, not raw syscalls — see syscall_haiku.go/zsyscall_haiku_amd64.go
+//   in korli/go).
+// - PROT_*/MAP_*/SOL_SOCKET/SO_KEEPALIVE values are copied from
+//   src/syscall/zerrors_haiku_amd64.go in korli/go (real, generated from
+//   Haiku's own headers), not guessed.
+// - Getpagesize is hardcoded to 4096: Haiku's page size on x86_64.
+// - Dup2/Access/FcntlFlock (and Flock_t/Errno) delegate to the stdlib
+//   syscall package, which already has all of them (fcntl(2) advisory
+//   locking is a real dynamic libroot.so call there, same family as
+//   mmap/setsockopt). R_OK/W_OK/X_OK aren't generated in korli/go (never
+//   needed by the Go runtime itself) but are POSIX-fixed values, not
+//   Haiku-specific ABI, so they're hardcoded rather than guessed at.
+//
+// Not verified against real Haiku hardware — the SYS_SET_MEMORY_PROTECTION
+// argument order (address, size, protection) is inferred by analogy with
+// POSIX mprotect(2) and Haiku's own SYS_MMAP-adjacent calls, since we have
+// no header access to confirm it. Wrong argument order would only surface
+// as a runtime bug on real Haiku, never as a build failure, which matches
+// the current scope: get github.com/unxed/f4 to compile for GOOS=haiku.
+// TODO: verify on real Haiku hardware once available, and consider
+// upstreaming a proper x/sys/unix Haiku port (korli/go's stdlib syscall
+// package already has most of the generated groundwork).
+//
+// MmapPtr/MunmapPtr are weaker still — see their own doc comment below,
+// they're a known-incomplete placeholder, not just an unverified one.
+
+//go:build haiku && amd64
+
+package unix
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+// --- poll(2) ---
+
+const (
+	POLLIN   = 0x0001
+	POLLOUT  = 0x0004
+	POLLERR  = 0x0008
+	POLLHUP  = 0x0010
+	POLLNVAL = 0x0020
+)
+
+type PollFd struct {
+	Fd      int32
+	Events  int16
+	Revents int16
+}
+
+// EINTR re-exports the stdlib syscall package's Haiku EINTR (generated from
+// Haiku's own headers in korli/go's src/syscall/zerrors_haiku_amd64.go), so
+// callers can keep comparing against unix.EINTR like on every other OS.
+const EINTR = syscall.EINTR
+
+// sysPoll is SYS_POLL from github.com/korli/go's
+// src/syscall/zsysnum_haiku_amd64.go — a real Haiku kernel syscall, not a
+// libroot.so dynamic call.
+const sysPoll = 127
+
+func Poll(fds []PollFd, timeout int) (n int, err error) {
+	var p *PollFd
+	if len(fds) > 0 {
+		p = &fds[0]
+	}
+	r0, _, e1 := syscall.Syscall(sysPoll, uintptr(unsafe.Pointer(p)), uintptr(len(fds)), uintptr(timeout))
+	n = int(r0)
+	if e1 != 0 {
+		err = e1
+	}
+	return
+}
+
+// --- mmap/mprotect family ---
+
+const (
+	PROT_NONE  = 0x0
+	PROT_READ  = 0x1
+	PROT_WRITE = 0x2
+	PROT_EXEC  = 0x4
+
+	MAP_SHARED  = 0x1
+	MAP_PRIVATE = 0x2
+	MAP_FIXED   = 0x4
+	MAP_ANON    = 0x8
+)
+
+func Mmap(fd int, offset int64, length int, prot int, flags int) (data []byte, err error) {
+	return syscall.Mmap(fd, offset, length, prot, flags)
+}
+
+func Munmap(b []byte) (err error) {
+	return syscall.Munmap(b)
+}
+
+// MmapPtr and MunmapPtr are a much weaker approximation than everything
+// else in this file: every other function here is believed correct
+// (backed by real Haiku syscall numbers or existing stdlib wrappers), but
+// placing a mapping at a caller-chosen fixed address needs the same
+// dynamic-libroot.so-call machinery the stdlib syscall package uses
+// internally (sysvicall6 in korli/go's syscall_haiku.go/asm_haiku_amd64.s)
+// — machinery this package can't reach from outside package syscall, and
+// reimplementing it here would mean duplicating a whole cgo-free calling
+// convention (see how much of that github.com/unxed/goffi needed for
+// this, which we specifically avoided depending on for Haiku — see
+// f4-haiku/patches/vtui-haiku.patch).
+//
+// So this is a placeholder, not a real MmapPtr: it ignores addr and
+// MAP_FIXED and does a normal Mmap instead, which will NOT land at addr.
+// That's enough for github.com/ncruces/go-sqlite3's internal/sqlite3_wrap
+// to compile; it is NOT enough to run correctly — its MappedRegion.Unmap
+// and .mmap assume the returned address matches what was asked for, to
+// grow a mapping in place. TODO before relying on SQLite on a real Haiku
+// build: extend korli/go's stdlib syscall package with a real
+// address-taking mmap variant (or reimplement the dynamic-call trampoline
+// properly in this package) rather than working around it here.
+func MmapPtr(fd int, offset int64, addr unsafe.Pointer, length uintptr, prot int, flags int) (ret unsafe.Pointer, err error) {
+	data, err := syscall.Mmap(fd, offset, int(length), prot, flags&^MAP_FIXED)
+	if err != nil || len(data) == 0 {
+		return nil, err
+	}
+	return unsafe.Pointer(&data[0]), nil
+}
+
+func MunmapPtr(addr unsafe.Pointer, length uintptr) (err error) {
+	return syscall.Munmap(unsafe.Slice((*byte)(addr), length))
+}
+
+// sysSetMemoryProtection is SYS_SET_MEMORY_PROTECTION from
+// src/syscall/zsysnum_haiku_amd64.go — Haiku's raw kernel syscall for
+// changing an existing mapping's protection (the mprotect(2) equivalent;
+// mprotect itself is not a libroot.so POSIX shim on Haiku, this is the
+// real kernel entry point).
+const sysSetMemoryProtection = 206
+
+func Mprotect(b []byte, prot int) (err error) {
+	var p unsafe.Pointer
+	if len(b) > 0 {
+		p = unsafe.Pointer(&b[0])
+	}
+	_, _, e1 := syscall.Syscall(sysSetMemoryProtection, uintptr(p), uintptr(len(b)), uintptr(prot))
+	if e1 != 0 {
+		err = e1
+	}
+	return
+}
+
+func Getpagesize() int { return 4096 }
+
+func Dup2(oldfd, newfd int) (err error) {
+	return syscall.Dup2(oldfd, newfd)
+}
+
+// --- errno, access(2), fcntl(2) advisory locking ---
+
+// Errno is a type ALIAS (not a new type) to syscall.Errno: every function
+// in this file that returns an error returns the stdlib syscall package's
+// own Errno underneath (via direct delegation or syscall.Syscall), so
+// callers doing `err.(unix.Errno)` type assertions need this to be the
+// same underlying type, not a distinct one.
+type Errno = syscall.Errno
+
+const (
+	EACCES     = syscall.EACCES
+	EAGAIN     = syscall.EAGAIN
+	EBUSY      = syscall.EBUSY
+	EDEADLK    = syscall.EDEADLK
+	EIO        = syscall.EIO
+	ENOLCK     = syscall.ENOLCK
+	ENOSPC     = syscall.ENOSPC
+	ENXIO      = syscall.ENXIO
+	EPERM      = syscall.EPERM
+	ERANGE     = syscall.ERANGE
+	ETIMEDOUT  = syscall.ETIMEDOUT
+	EWOULDBLOCK = syscall.EWOULDBLOCK
+)
+
+// O_NOFOLLOW's value is copied from src/syscall/zerrors_haiku_amd64.go in
+// korli/go (real, generated from Haiku's own headers), not guessed.
+const O_NOFOLLOW = 0x80000
+
+// R_OK/W_OK/X_OK aren't generated anywhere in korli/go's stdlib syscall
+// package (the Go runtime/stdlib itself never calls access(2), so korli
+// never needed them) — these are the POSIX-mandated access(2) mode bits,
+// which every real Unix access(2) implementation uses verbatim; unlike
+// the errno/ioctl numbers elsewhere in this file, there's no plausible
+// way for Haiku to differ here.
+const (
+	F_OK = 0x0
+	X_OK = 0x1
+	W_OK = 0x2
+	R_OK = 0x4
+)
+
+func Access(path string, mode uint32) (err error) {
+	return syscall.Access(path, mode)
+}
+
+// Flock_t and FcntlFlock delegate to the stdlib syscall package, which
+// already implements fcntl(2) advisory locking for Haiku (F_GETLK/F_SETLK
+// go through a real dynamic libroot.so call, same family as
+// mmap/setsockopt above).
+type Flock_t = syscall.Flock_t
+
+const (
+	F_GETLK = syscall.F_GETLK
+	F_SETLK = syscall.F_SETLK
+	F_RDLCK = syscall.F_RDLCK
+	F_WRLCK = syscall.F_WRLCK
+	F_UNLCK = syscall.F_UNLCK
+)
+
+func FcntlFlock(fd uintptr, cmd int, lk *Flock_t) error {
+	return syscall.FcntlFlock(fd, cmd, lk)
+}
+
+// flock(2) — like Poll/Mprotect above, SYS_FLOCK is a real Haiku kernel
+// syscall number (src/syscall/zsysnum_haiku_amd64.go in korli/go), not a
+// dynamic libroot.so call, so this needs no stdlib delegation.
+
+const (
+	LOCK_SH = 0x1
+	LOCK_EX = 0x2
+	LOCK_NB = 0x4
+	LOCK_UN = 0x8
+)
+
+const sysFlock = 113
+
+func Flock(fd int, how int) (err error) {
+	_, _, e1 := syscall.Syscall(sysFlock, uintptr(fd), uintptr(how), 0)
+	if e1 != 0 {
+		err = e1
+	}
+	return
+}
+
+// --- open/close, fcntl flags, rlimit, tty ioctls ---
+//
+// Needed by github.com/unxed/f4/internal/terminal's session handling and
+// its (also new, see f4-haiku.patch) pty_haiku.go PTY backend.
+
+// open(2)/close(2) are real Haiku kernel syscalls (SYS_OPEN=107,
+// SYS_CLOSE=151 in korli/go's src/syscall/zsysnum_haiku_amd64.go), same
+// family as Poll/Mprotect/Flock above.
+const (
+	sysOpen  = 107
+	sysClose = 151
+)
+
+const (
+	O_RDWR    = 0x2
+	O_NOCTTY  = 0x1000
+	O_CLOEXEC = 0x40
+	O_NONBLOCK = 0x80
+)
+
+func Open(path string, mode int, perm uint32) (fd int, err error) {
+	p, err := syscall.BytePtrFromString(path)
+	if err != nil {
+		return -1, err
+	}
+	r0, _, e1 := syscall.Syscall(sysOpen, uintptr(unsafe.Pointer(p)), uintptr(mode), uintptr(perm))
+	fd = int(r0)
+	if e1 != 0 {
+		err = e1
+	}
+	return
+}
+
+func Close(fd int) (err error) {
+	_, _, e1 := syscall.Syscall(sysClose, uintptr(fd), 0, 0)
+	if e1 != 0 {
+		err = e1
+	}
+	return
+}
+
+// FcntlInt/F_SETFD/F_GETFL/F_SETFL/FD_CLOEXEC delegate to
+// github.com/unxed/go's syscall.FcntlInt (see that fork's
+// src/syscall/syscall_haiku.go — added specifically to back this file: a
+// thin exported wrapper around the already-correct unexported fcntl(),
+// which goes through the dynamic libroot.so call, same as FcntlFlock).
+const (
+	F_SETFD   = 0x4
+	F_GETFL   = 0x8
+	F_SETFL   = 0x10
+	FD_CLOEXEC = 0x1
+)
+
+func FcntlInt(fd uintptr, cmd int, arg int) (int, error) {
+	return syscall.FcntlInt(fd, cmd, arg)
+}
+
+func SetNonblock(fd int, nonblocking bool) (err error) {
+	flags, err := FcntlInt(uintptr(fd), F_GETFL, 0)
+	if err != nil {
+		return err
+	}
+	if nonblocking {
+		flags |= O_NONBLOCK
+	} else {
+		flags &^= O_NONBLOCK
+	}
+	_, err = FcntlInt(uintptr(fd), F_SETFL, flags)
+	return err
+}
+
+// Rlimit/Getrlimit/RLIMIT_NOFILE delegate to the stdlib syscall package,
+// which already has all three (a real dynamic libroot.so call, per
+// korli/go's src/syscall/zsyscall_haiku_amd64.go).
+type Rlimit = syscall.Rlimit
+
+const RLIMIT_NOFILE = syscall.RLIMIT_NOFILE
+
+func Getrlimit(which int, lim *Rlimit) (err error) {
+	return syscall.Getrlimit(which, lim)
+}
+
+// TTY ioctl numbers, copied from Haiku's own
+// headers/posix/termios.h (all offsets from TCGETA=0x8000, verified
+// against github.com/haiku/haiku source, not guessed): TIOCGWINSZ
+// (TCGETA+12), TIOCSWINSZ (+13), TIOCGPGRP (+15), TIOCSPGRP (+16),
+// TIOCSCTTY (+17).
+const (
+	TIOCGWINSZ = 0x800c
+	TIOCSWINSZ = 0x800d
+	TIOCGPGRP  = 0x800f
+	TIOCSPGRP  = 0x8010
+	TIOCSCTTY  = 0x8011
+)
+
+// --- socket options ---
+
+const (
+	SOL_SOCKET   = -0x1
+	SO_KEEPALIVE = 0x10
+)
+
+func SetsockoptInt(fd, level, opt int, value int) (err error) {
+	return syscall.SetsockoptInt(fd, level, opt, value)
+}
