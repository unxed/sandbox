--- a/internal/sysfs/ino_unix.go
+++ b/internal/sysfs/ino_unix.go
@@ -15,7 +15,12 @@ func inoFromFileInfo(_ string, info fs.FileInfo) (sys.Inode, experimentalsys.Err
 	case *sys.Stat_t:
 		return v.Ino, 0
 	case *syscall.Stat_t:
