diff --git a/sgr_limit.go b/sgr_limit.go
new file mode 100644
index 0000000..358582b
--- /dev/null
+++ b/sgr_limit.go
@@ -0,0 +1,8 @@
+package vtui
+
+// maxSGRParams caps how many parameters one SGR (CSI ... m) sequence may carry;
+// 0 means no cap. formatAttributesCSI merges reset, style, fg and bg into one
+// sequence, which reaches 11+ parameters for "0;" plus a true colour pair
+// (0;38;2;R;G;B;48;2;R;G;B). Most terminals take any number, but see
+// sgr_limit_haiku.go.
+var maxSGRParams = 0
diff --git a/sgr_limit_haiku.go b/sgr_limit_haiku.go
new file mode 100644
index 0000000..ffbf0ce
--- /dev/null
+++ b/sgr_limit_haiku.go
@@ -0,0 +1,10 @@
+//go:build haiku
+
+package vtui
+
+// Haiku's Terminal parses at most 10 parameters per escape sequence
+// (#define NPARAM 10 in src/apps/terminal/TermParse.cpp in haiku/haiku): the
+// extra ';' are dropped and the digits that follow are appended to the 10th
+// parameter, so "0;38;2;R;G;B;48;2;R;G;B" paints the background with garbage
+// (seen as solid green rows in f4). Keep every SGR sequence within the limit.
+func init() { maxSGRParams = 10 }
