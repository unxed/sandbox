new file mode 100644
index 0000000..e74b461
--- /dev/null
+++ b/term_unix_haiku.go
@@ -0,0 +1,15 @@
+// Copyright 2013 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build haiku
+
+package term
+
+import "golang.org/x/sys/unix"
+
+// Haiku has no TCGETS/TCSETS: libroot's tcgetattr/tcsetattr are
+// ioctl(TCGETA)/ioctl(TCSETA*) on a struct termios (headers/posix/termios.h,
+// TCGETA = 0x8000). Both constants come from github.com/korli/sys_haiku.
+const ioctlReadTermios = unix.TCGETA
+const ioctlWriteTermios = unix.TCSETA
