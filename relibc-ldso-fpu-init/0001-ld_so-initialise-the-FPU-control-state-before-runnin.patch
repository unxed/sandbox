From 0264de1f920bfdb398a86e0ea9c9de2bba483f00 Mon Sep 17 00:00:00 2001
From: unxed <ivan.sorokin.tech@gmail.com>
Date: Sat, 19 Sep 2026 08:53:48 +0000
Subject: [PATCH] ld_so: initialise the FPU control state before running any
 Rust code

A process created by posix_spawn starts with all-zero FPU control state: MXCSR = 0
leaves every SSE exception unmasked, and because the kernel does not set
CR4.OSXMMEXCPT the first inexact SSE result raises #UD, reported as an "Invalid opcode
fault" that kills the process. (A forked or exec'ed process inherits sane values from
the process that created it.) crt0 initialises MXCSR and the x87 control word, but the
dynamic loader's own _start runs first and executes Rust code, including floating point
code paths, with the zeroed state: about one in a few dozen spawned children of a
dynamically linked program died in the loader with an invalid-opcode fault before main.

Set the ABI defaults (fninit; ldmxcsr 0x1f80) at the top of the loader's x86_64 _start.
---
 ld_so/src/lib.rs | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ld_so/src/lib.rs b/ld_so/src/lib.rs
index ca22a2f..c5b8495 100644
--- a/ld_so/src/lib.rs
+++ b/ld_so/src/lib.rs
@@ -88,6 +88,15 @@ global_asm!(
 
 .globl _start
 _start:
+    # A process created by posix_spawn starts with all-zero FPU control state (a forked or
+    # exec'ed one inherits sane values). MXCSR = 0 leaves every SSE exception unmasked, and
+    # since CR4.OSXMMEXCPT is not set the first inexact result raises #UD ("Invalid opcode
+    # fault") -- in this loader, before crt0 gets a chance to initialise the state. Set the
+    # ABI defaults (x87 CW 0x37f via fninit, MXCSR 0x1f80) before running any Rust code.
+    fninit
+    mov DWORD PTR [rsp - 8], 0x00001F80
+    ldmxcsr [rsp - 8]
+
     lea rsi, [rip + _start]
 
     # Save original stack and align stack to 16 bytes
-- 
2.43.0

