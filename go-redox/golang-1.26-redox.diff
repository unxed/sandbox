index 00000000..feede8f4
--- /dev/null
+++ b/.github/workflows/redox-cross-build.yml
@@ -0,0 +1,365 @@
+name: redox-cross-build
+
+on:
+  push:
+    branches: [golang-1.26-redox]
+  workflow_dispatch: {}
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-go@v5
+        with:
+          go-version: '1.24'
+          cache: false
+
+      # QEMU iteration is the bottleneck; fetch the (large) redoxer image in
+      # the background while other steps run.
+      - name: Prefetch redoxer image in the background
+        run: |
+          nohup docker pull redoxos/redoxer > /tmp/docker-pull.log 2>&1 &
+
+      - name: Install cc wrapper that runs redoxer's cross compiler in Docker
+        timeout-minutes: 2
+        run: |
+          sudo tee /usr/local/bin/redox-cc >/dev/null <<'EOF'
+          #!/bin/sh
+          docker run --rm -i -v /tmp:/tmp -v "$GITHUB_WORKSPACE:$GITHUB_WORKSPACE" -w "$PWD" \
+            redoxos/redoxer redoxer cc "$@"
+          rc=$?
+          # the container runs as root: hand every -o output back to the caller
+          prev=""
+          for a in "$@"; do
+            [ "$prev" = "-o" ] && sudo chown "$(id -u):$(id -g)" "$a" 2>/dev/null
+            prev="$a"
+          done
+          exit $rc
+          EOF
+          sudo chmod +x /usr/local/bin/redox-cc
+
+      # syscall's generated files come from relibc's real headers, not from
+      # hand-written tables: cgo -godefs (types, errno/signal/etc constants)
+      # via redoxer's compiler, and mksyscall_redox.pl for the libc stubs.
+      - name: Generate syscall/ztypes, zerrors (cgo -godefs) and zsyscall (mksyscall)
+        if: github.event_name == 'workflow_dispatch' || contains(github.event.head_commit.message, '[full]')
+        timeout-minutes: 3
+        run: |
+          set -o pipefail
+          export CC=/usr/local/bin/redox-cc
+          python3 .github/redox/gen_syscall.py 2>&1 | tee /tmp/gen-syscall.log
+          cd src/syscall
+          perl mksyscall_redox.pl -tags redox,amd64 syscall_redox.go syscall_redox_amd64.go > zsyscall_redox_amd64.go
+          wc -l z*_redox_amd64.go
+          cd ../..
+          echo '--- drift of freshly generated files vs. the committed ones (empty = in sync) ---'
+          git diff --stat -- src/syscall/z*_redox_amd64.go | tee /tmp/gen-drift.txt
+
+      - name: Upload generated syscall files
+        if: (github.event_name == 'workflow_dispatch' || contains(github.event.head_commit.message, '[full]')) && always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: redox-generated-syscall
+          path: |
+            src/syscall/ztypes_redox_amd64.go
+            src/syscall/zerrors_redox_amd64.go
+            src/syscall/zsyscall_redox_amd64.go
+            /tmp/gen-syscall.log
+          if-no-files-found: warn
+
+      # The toolchain only depends on src/ and VERSION: reuse it across rounds
+      # that change nothing but CI files, tests or docs.
+      - name: Cache the built toolchain (bin, pkg)
+        id: tc
+        uses: actions/cache@v4
+        with:
+          path: |
+            bin
+            pkg
+          key: redox-toolchain-v3-${{ hashFiles('src/**', 'VERSION') }}
+
+      - name: Cache the go build cache
+        uses: actions/cache@v4
+        with:
+          path: ~/.cache/go-build
+          key: redox-gocache-${{ hashFiles('src/**', 'VERSION') }}
+          restore-keys: redox-gocache-
+
+      - name: Build host (linux/amd64) toolchain
+        if: steps.tc.outputs.cache-hit != 'true' || hashFiles('genfiles.tgz') == ''
+        timeout-minutes: 4
+        working-directory: src
+        run: |
+          export GOROOT_BOOTSTRAP=$(dirname $(dirname $(which go)))
+          echo "GOROOT_BOOTSTRAP=$GOROOT_BOOTSTRAP"
+          ./make.bash
+          # make.bash also writes untracked generated sources (zzipdata.go, zbootstrap.go, ...):
+          # keep them with the cached toolchain
+          cd ..
+          git ls-files --others -i --exclude-standard src | tar czf genfiles.tgz -T -
+          tar tzf genfiles.tgz | head -20
+
+      - name: Restore generated sources of the cached toolchain
+        if: steps.tc.outputs.cache-hit == 'true' && hashFiles('genfiles.tgz') != ''
+        run: tar xzf genfiles.tgz && tar tzf genfiles.tgz | wc -l
+
+      # Bulk compile check of the std packages we care about, reporting ALL
+      # errors (-e) across independent packages in one round.
+      - name: Compile-check std packages for GOOS=redox
+        if: github.event_name == 'workflow_dispatch' || contains(github.event.head_commit.message, '[full]')
+        timeout-minutes: 3
+        continue-on-error: true
+        run: |
+          export GOROOT=$(pwd)
+          export PATH=$GOROOT/bin:$PATH
+          go version
+          GOOS=redox GOARCH=amd64 CGO_ENABLED=0 go build -gcflags=-e \
+            syscall internal/syscall/unix internal/poll os fmt time os/signal os/exec io/fs net crypto/rand \
+            2>&1 | tee /tmp/compile-check.log
+          echo "compile-check finished; $(grep -c . /tmp/compile-check.log) lines of output"
+
+      - name: Upload compile-check log
+        if: (github.event_name == 'workflow_dispatch' || contains(github.event.head_commit.message, '[full]')) && always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: redox-compile-check
+          path: /tmp/compile-check.log
+          if-no-files-found: ignore
+
+      # Regression check for the packages that touch syscall.Stat_t & friends
+      # (the full "std" compile check is in the optional step above).
+      - name: Compile-check packages that use syscall types
+        timeout-minutes: 3
+        continue-on-error: true
+        run: |
+          export GOROOT=$(pwd)
+          export PATH=$GOROOT/bin:$PATH
+          GOOS=redox GOARCH=amd64 CGO_ENABLED=0 go build archive/tar archive/zip os/user os/exec os/signal io/fs net net/http 2>&1 | tee /tmp/compile-quick.log
+          echo "compile-quick: $(grep -c . /tmp/compile-quick.log) lines of errors"
+
+      # The validation ladder: independent programs of increasing difficulty,
+      # each built separately so failures are attributable. x17 is plain C,
+      # compiled by redoxer's cross compiler (also proves the C toolchain works).
+      - name: Build the validation-ladder programs
+        timeout-minutes: 3
+        run: |
+          export GOROOT=$(pwd)
+          export PATH=$GOROOT/bin:$PATH
+          rm -rf /tmp/ladder /tmp/pkg && mkdir -p /tmp/ladder /tmp/pkg/out
+          cp -r .github/redox/ladder/* /tmp/ladder/
+          printf 'module ladder\n\ngo 1.26\n' > /tmp/ladder/go.mod
+          : > /tmp/pkg/ladder-build.txt
+          cd /tmp/ladder
+          for d in p*/ x*/; do
+            n=${d%/}
+            if [ -f $n/main.c ]; then
+              if /usr/local/bin/redox-cc -O1 -pthread -o /tmp/pkg/out/$n.bin $n/main.c > /tmp/ladder-build-$n.log 2>&1; then
+                echo "$n BUILD_OK" >> /tmp/pkg/ladder-build.txt
+              else
+                echo "$n BUILD_FAIL" >> /tmp/pkg/ladder-build.txt
+                echo "::group::build of $n failed"; tail -60 /tmp/ladder-build-$n.log; echo "::endgroup::"
+              fi
+              continue
+            fi
+            cgo=0; xflag=""; [ -f $n/NEEDS_CGO ] && { cgo=1; xflag=-x; }
+            if GOOS=redox GOARCH=amd64 CGO_ENABLED=$cgo CC=/usr/local/bin/redox-cc go build $xflag -o /tmp/pkg/out/$n.bin ./$n > /tmp/ladder-build-$n.log 2>&1; then
+              echo "$n BUILD_OK" >> /tmp/pkg/ladder-build.txt
+            else
+              echo "$n BUILD_FAIL" >> /tmp/pkg/ladder-build.txt
+              echo "::group::build of $n failed"; tail -60 /tmp/ladder-build-$n.log; echo "::endgroup::"
+            fi
+          done
+          cp /tmp/ladder-build-*.log /tmp/pkg/
+          cp $GITHUB_WORKSPACE/.github/redox/run_*.sh /tmp/pkg/out/
+          # the run scripts are sourced from the VM as /root/mnt/common.sh
+          mv /tmp/pkg/out/run_common.sh /tmp/pkg/out/common.sh
+          cat /tmp/pkg/ladder-build.txt
+          ls -la /tmp/pkg/out
+
+      # Cross-compiled std test binaries (go test -c) for a small set of packages.
+      - name: Build std test binaries
+        timeout-minutes: 4
+        continue-on-error: true
+        run: |
+          export GOROOT=$(pwd)
+          export PATH=$GOROOT/bin:$PATH
+          rm -rf /tmp/pkgt && mkdir -p /tmp/pkgt/out/data
+          for p in strings bytes sort container/list encoding/json sync time; do
+            n=$(echo $p | tr / _)
+            mkdir -p /tmp/pkgt/out/data/$n
+            if GOOS=redox GOARCH=amd64 CGO_ENABLED=0 go test -c -o /tmp/pkgt/out/$n.test $p > /tmp/pkgt/test-build-$n.log 2>&1; then
+              echo "$n TESTBUILD_OK"
+              touch /tmp/pkgt/out/data/$n/.keep; cp src/$p/*.go /tmp/pkgt/out/data/$n/ 2>/dev/null; [ -d src/$p/testdata ] && cp -r src/$p/testdata /tmp/pkgt/out/data/$n/
+              chmod +x /tmp/pkgt/out/$n.test
+            else
+              echo "$n TESTBUILD_FAIL"; head -40 /tmp/pkgt/test-build-$n.log
+            fi
+          done
+          mkdir -p /tmp/pkgt/out/lib/time && cp lib/time/zoneinfo.zip /tmp/pkgt/out/lib/time/   # time tests load ../../lib/time/zoneinfo.zip
+          cp .github/redox/run_common.sh /tmp/pkgt/out/common.sh
+          cp .github/redox/run_tests.sh /tmp/pkgt/out/
+          du -sh /tmp/pkgt/out; ls -la /tmp/pkgt/out
+
+      - name: Upload std test binaries
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: redox-std-tests
+          path: /tmp/pkgt
+          if-no-files-found: ignore
+
+      - name: Upload build logs and binaries
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: redox-cross-build-output
+          path: /tmp/pkg
+          if-no-files-found: warn
+
+  # The exit hang is a kernel bug (see .github/redox/kernel/): a thread that
+  # procmgr ForceKills while it is about to block is never woken. So every VM job
+  # runs twice: on the stock kernel of redoxer's image, and on the same kernel
+  # source with .github/redox/kernel/0001-futex-don-t-sleep-on-an-untimed-wait-when-the-contex.patch applied.
+  kernel:
+    runs-on: ubuntu-latest
+    timeout-minutes: 8
+    env:
+      KERNEL_SHA: 2d2eef740a461bb6f60eff9cbe6a4a54168ce0b5
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build the patched Redox kernel
+        timeout-minutes: 6
+        run: |
+          sudo apt-get install -y -qq nasm >/dev/null
+          rustup toolchain install nightly-2026-05-24 --profile minimal -c rust-src 2>&1 | tail -2
+          mkdir /tmp/kernel-src && cd /tmp/kernel-src
+          git init -q . && git remote add origin https://gitlab.redox-os.org/redox-os/kernel.git
+          git fetch -q --depth 1 origin $KERNEL_SHA && git checkout -q FETCH_HEAD
+          git apply $GITHUB_WORKSPACE/.github/redox/kernel/0001-futex-don-t-sleep-on-an-untimed-wait-when-the-contex.patch
+          make ARCH=x86_64 OBJCOPY=objcopy BUILD=/tmp/kbuild all 2>&1 | tail -5
+          ls -la /tmp/kbuild/kernel
+      - uses: actions/upload-artifact@v4
+        with:
+          name: redox-kernel-patched
+          path: /tmp/kbuild/kernel
+
+  # The VM jobs run in parallel, each with its own QEMU boot (TCG, no KVM).
+  vm-ladder:
+    needs: [build, kernel]
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    strategy:
+      fail-fast: false
+      matrix:
+        kernel: [stock, patched]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/download-artifact@v4
+        with:
+          name: redox-cross-build-output
+          path: /tmp/pkg
+      - uses: actions/download-artifact@v4
+        if: matrix.kernel == 'patched'
+        with:
+          name: redox-kernel-patched
+          path: /tmp/kpatched
+      - name: Enable KVM
+        run: .github/redox/enable_kvm.sh
+      - name: Run the ladder under redoxer (${{ matrix.kernel }} kernel)
+        continue-on-error: true
+        timeout-minutes: 5
+        run: |
+          chmod +x /tmp/pkg/out/*.bin
+          k=""; [ "${{ matrix.kernel }}" = patched ] && k=/tmp/kpatched/kernel
+          .github/redox/vm_run.sh run_ladder.sh /tmp/redoxer-exec.log $k
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: redoxer-exec-output-${{ matrix.kernel }}
+          path: /tmp/redoxer-exec.log
+          if-no-files-found: ignore
+      - name: Ladder summary (${{ matrix.kernel }} kernel; fails unless every gating rung passed)
+        if: always()
+        run: python3 .github/redox/ladder_summary.py /tmp/redoxer-exec.log main
+
+  vm-exit:
+    needs: [build, kernel]
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    strategy:
+      fail-fast: false
+      matrix:
+        kernel: [stock, patched]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/download-artifact@v4
+        with:
+          name: redox-cross-build-output
+          path: /tmp/pkg
+      - uses: actions/download-artifact@v4
+        if: matrix.kernel == 'patched'
+        with:
+          name: redox-kernel-patched
+          path: /tmp/kpatched
+      - name: Enable KVM
+        run: .github/redox/enable_kvm.sh
+      - name: Run the exit-hang probes under redoxer (${{ matrix.kernel }} kernel)
+        continue-on-error: true
+        timeout-minutes: 5
+        run: |
+          chmod +x /tmp/pkg/out/*.bin
+          k=""; [ "${{ matrix.kernel }}" = patched ] && k=/tmp/kpatched/kernel
+          .github/redox/vm_run.sh run_exit.sh /tmp/redoxer-exit.log $k
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: redoxer-exit-output-${{ matrix.kernel }}
+          path: /tmp/redoxer-exit.log
+          if-no-files-found: ignore
+      - name: Exit-probe summary (diagnostic; never fails the job)
+        if: always()
+        run: python3 .github/redox/ladder_summary.py /tmp/redoxer-exit.log exit || true
+
+  vm-tests:
+    needs: [build, kernel]
+    runs-on: ubuntu-latest
+    timeout-minutes: 12
+    strategy:
+      fail-fast: false
+      matrix:
+        kernel: [stock, patched]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/download-artifact@v4
+        with:
+          name: redox-std-tests
+          path: /tmp/pkgt
+      - uses: actions/download-artifact@v4
+        if: matrix.kernel == 'patched'
+        with:
+          name: redox-kernel-patched
+          path: /tmp/kpatched
+      - name: Enable KVM
+        run: .github/redox/enable_kvm.sh
+      - name: Run the std test binaries under redoxer (${{ matrix.kernel }} kernel)
+        continue-on-error: true
+        timeout-minutes: 8
+        run: |
+          chmod +x /tmp/pkgt/out/*.test
+          k=""; [ "${{ matrix.kernel }}" = patched ] && k=/tmp/kpatched/kernel
+          PKGOUT=/tmp/pkgt/out .github/redox/vm_run.sh run_tests.sh /tmp/redoxer-tests.log $k
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: redoxer-tests-output-${{ matrix.kernel }}
+          path: /tmp/redoxer-tests.log
+          if-no-files-found: ignore
+      - name: Per-package results (${{ matrix.kernel }} kernel)
+        if: always()
+        run: python3 .github/redox/test_summary.py /tmp/redoxer-tests.log
