+     // LEA doesn't support 16x, so just do two x8s.
+-    lea rdx, [rdx + 8 * rcx]
+-    lea rdx, [rdx + 8 * rcx]
++    lea rdx, [rdx + 8 * r10]
++    lea rdx, [rdx + 8 * r10]
+ 
