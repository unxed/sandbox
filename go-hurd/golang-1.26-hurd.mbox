+func Minor(dev uint64) uint32 { return uint32((dev & 0xff) | ((dev >> 12) &^ 0xff)) }
+func Mkdev(major, minor uint32) uint64 {
+	maj, min := uint64(major), uint64(minor)
+	return ((maj &^ 0xfff) << 32) | ((maj & 0xfff) << 8) | ((min &^ 0xff) << 12) | (min & 0xff)
+}
