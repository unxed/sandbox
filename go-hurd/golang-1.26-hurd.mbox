 3 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/hurd-cross-build.yml b/.github/workflows/hurd-cross-build.yml
index c59e1aa4..d005e5b0 100644
--- a/.github/workflows/hurd-cross-build.yml
+++ b/.github/workflows/hurd-cross-build.yml
