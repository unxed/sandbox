+}
+
 func pthread_attr_setstack(attr *pthreadattr, addr uintptr, size uint64) int32 {
 	return int32(sysvicall3(&libc_pthread_attr_setstack, uintptr(unsafe.Pointer(attr)), uintptr(addr), uintptr(size)))
