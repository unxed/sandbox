-	MOVQ    R10, 192(SP)
+	MOVQ    R10, 176(SP)
 
 	// save m->scratch
 	LEAQ	(m_mOS+mOS_scratch)(BP), R11
 	MOVQ	0(R11), R10
-	MOVQ	R10, 128(SP)
+	MOVQ	R10, 112(SP)
 	MOVQ	8(R11), R10
-	MOVQ	R10, 136(SP)
+	MOVQ	R10, 120(SP)
 	MOVQ	16(R11), R10
-	MOVQ	R10, 144(SP)
+	MOVQ	R10, 128(SP)
 	MOVQ	24(R11), R10
-	MOVQ	R10, 152(SP)
+	MOVQ	R10, 136(SP)
 	MOVQ	32(R11), R10
-	MOVQ	R10, 160(SP)
+	MOVQ	R10, 144(SP)
 	MOVQ	40(R11), R10
-	MOVQ	R10, 168(SP)
+	MOVQ	R10, 152(SP)
 
 	// save errno, it might be EINTR; stuff we do here might reset it.
 	MOVQ	(m_mOS+mOS_perrno)(BP), R10
 	MOVL	0(R10), R10
-	MOVQ	R10, 176(SP)
+	MOVQ	R10, 160(SP)
 
