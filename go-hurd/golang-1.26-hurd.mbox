From a32ecc53dc9a5cd2c527dcf2584a2036658d2282 Mon Sep 17 00:00:00 2001
From: unxed <unxed@users.noreply.github.com>
Date: Fri, 18 Sep 2026 15:09:24 +0000
Subject: [PATCH 11/48] sys_hurd_amd64: dereference libc_xxx dynamic-import
 symbols before calling

Root cause of the SIGSEGV (crashing inside .got, confirmed via readelf -r:
all libc_xxx symbols get R_X86_64_GLOB_DAT relocations -- by definition
the dynamic linker writes the *resolved function address* into that slot;
you must load-then-call, never jump directly to the slot's own address).

Fixed in all four places code was calling straight into a libc_xxx symbol
address without the intervening dereference:
- miniterrno: CALL DI -> MOVQ (DI), AX; CALL AX
- asmsysvicall6: added MOVQ (AX), AX before the final CALL AX
- usleep2/osyield1 trampolines: LEAQ (address-of) -> MOVQ (load contents)

Confirmed via readelf -r on the crashing binary: getpid's GLOB_DAT slot is
at the exact address region the crash PC landed in, and via addr2line
showing the crash inside asmsysvicall6/miniterrno's own CALL, with no
other runtime code between rt0_go and the crash -- this is the very first
libc call the program ever makes, on any of these paths.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015F6Vb87BFK4j9tVQhdKr9H
---
 src/runtime/sys_hurd_amd64.s | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/runtime/sys_hurd_amd64.s b/src/runtime/sys_hurd_amd64.s
index 6ca76667..e9bfade9 100644
--- a/src/runtime/sys_hurd_amd64.s
+++ b/src/runtime/sys_hurd_amd64.s
@@ -20,7 +20,11 @@ TEXT runtime·settls(SB),NOSPLIT,$8
 // NOT USING GO CALLING CONVENTION.
 TEXT runtime·miniterrno(SB),NOSPLIT,$0
 	// asmcgocall will put first argument into DI.
-	CALL	DI	// SysV ABI so returns in AX
+	// DI holds the address of the libc_xxx dynamic-import symbol slot
+	// (an R_X86_64_GLOB_DAT relocation target); it must be dereferenced
+	// once to get the resolved function pointer before calling it.
+	MOVQ	(DI), AX
+	CALL	AX	// SysV ABI so returns in AX
 	get_tls(CX)
 	MOVQ	g(CX), BX
 	MOVQ	g_m(BX), BX
@@ -66,6 +70,11 @@ skiperrno1:
 	MOVQ	40(R11), R9
 skipargs:
 
+	// libcall_fn(DI) (loaded into AX above) is the address of the
+	// libc_xxx dynamic-import symbol slot (R_X86_64_GLOB_DAT target),
+	// not the callable address itself -- dereference once.
+	MOVQ	(AX), AX
+
 	// Call SysV function
 	CALL	AX
 
@@ -293,12 +302,15 @@ usleep1_noswitch:
 
 // Runs on OS stack. duration (in µs units) is in DI.
 TEXT usleep2<>(SB),NOSPLIT,$0
-	LEAQ	libc_usleep(SB), AX
+	// libc_usleep(SB) is an R_X86_64_GLOB_DAT slot; MOVQ loads its
+	// resolved contents (the callable address), unlike LEAQ which would
+	// take the slot's own address.
+	MOVQ	libc_usleep(SB), AX
 	CALL	AX
 	RET
 
 // Runs on OS stack, called from runtime·osyield.
 TEXT runtime·osyield1(SB),NOSPLIT,$0
-	LEAQ	libc_sched_yield(SB), AX
+	MOVQ	libc_sched_yield(SB), AX
 	CALL	AX
 	RET
