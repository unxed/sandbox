 	// g = m->gsignal
@@ -206,12 +206,6 @@ allgood:
 	MOVQ	SI, 8(SP)
 	MOVQ	DX, 16(SP)
 	MOVQ	R10, 24(SP)
-	// glibc's Hurd trampoline calls us with, above the return address (at
