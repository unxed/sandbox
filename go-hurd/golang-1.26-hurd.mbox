           if [ -d "$GOROOT/misc/hurd/xsys-unix" ]; then
             rm -f vendor/golang.org/x/sys/unix/*
-            cp "$GOROOT"/misc/hurd/xsys-unix/*.go vendor/golang.org/x/sys/unix/
+            cp "$GOROOT"/misc/hurd/xsys-unix/*.go "$GOROOT"/misc/hurd/xsys-unix/*.s vendor/golang.org/x/sys/unix/
+            python3 "$GOROOT/.github/scripts/gen_unix_consts.py" "$GOROOT/src/syscall/zerrors_hurd_amd64.go" vendor/golang.org/x/sys/unix vendor/golang.org/x/sys/unix/zconsts_hurd.go
           fi
